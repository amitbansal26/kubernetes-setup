# Example Environment Variables Configuration
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control!

# Red Hat Subscription Manager Credentials
# Required for RHEL 9 VM provisioning
RHSM_USERNAME="your-redhat-username"
RHSM_PASSWORD="your-redhat-password"

# Cluster Configuration
# Root password for all nodes (change from default 'kubeadmin')
ROOT_PASSWORD="change-this-password"

# Keepalived Configuration (for HA setups)
# Authentication password for VRRP (change from default 'mysecret')
KEEPALIVED_AUTH_PASS="change-this-secret"

# Network Configuration
MASTER_IP="172.16.16.100"
WORKER1_IP="172.16.16.101"
WORKER2_IP="172.16.16.102"
POD_NETWORK_CIDR="20.96.0.0/12"

# Node Resources
MASTER_CPUS=2
MASTER_MEMORY=2048
WORKER_CPUS=2
WORKER_MEMORY=4096

# Kubernetes Version
K8S_VERSION="v1.29"

# Notes:
# - Update Vagrantfile to use these environment variables
# - For Ansible deployments, use ansible-vault for sensitive data
# - Ensure this file has restricted permissions: chmod 600 .env
